<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fitness</groupId>
  <artifactId>fitness-assistant</artifactId>
  <name>Βοηθός Προπόνησης</name>
  <version>1.0-SNAPSHOT</version>
  <description>Εφαρμογή ανάλυσης αθλητικών δραστηριοτήτων από αρχεία TCX</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>coach</finalName>
              <transformers>
                <transformer>
                  <mainClass>Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>gui.FitnessApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>mac-aarch64</id>
      <properties>
        <javafx.classifier>mac-aarch64</javafx.classifier>
      </properties>
    </profile>
    <profile>
      <id>mac-x86</id>
      <properties>
        <javafx.classifier>mac</javafx.classifier>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <properties>
        <javafx.classifier>win</javafx.classifier>
      </properties>
    </profile>
    <profile>
      <id>linux</id>
      <properties>
        <javafx.classifier>linux</javafx.classifier>
      </properties>
    </profile>
  </profiles>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.2</javafx.version>
    <javafx.classifier>mac-aarch64</javafx.classifier>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
  </properties>
</project>
